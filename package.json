{
  "name": "tg-native-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin for designing native Telegram Mini Apps: theme params as variables, theme matrix, system components, audits.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "preact": "^10.24.0"
  }
}
